APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
WEB_CONCURRENCY=1

# Neon PostgreSQL. Copy both strings from the Neon console Connect dialog.
# The running API uses the pooled endpoint (host contains -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Alembic, seed, and database checks use the direct endpoint.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# Automated tests use the direct endpoint of a dedicated child branch.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/DBNAME?sslmode=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=240
DB_CONNECT_TIMEOUT_SECONDS=15
DB_CONNECT_RETRIES=5

# Authentication and browser access. Generate a unique random JWT secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost:5173
DRIFT_REHYDRATE_LIMIT=1000

# Model artifacts remain on this machine; they are not stored in Neon.
MODEL_ARTIFACT_DIRECTORY=data/artifacts/model
PREPROCESSOR_ARTIFACT_DIRECTORY=data/artifacts/preprocessor
PREDICTION_THRESHOLD=0.50

# Local demo seeding. These are local-showcase-only example passwords;
# replace them outside an ephemeral demo. Seeding is refused in production.
SEED_DEMO_USERS=true
SEED_ADMIN_PASSWORD=Admin@Demo2026
SEED_ANALYST_PASSWORD=Analyst@Demo2026
SEED_OFFICER_EXPLAIN_PASSWORD=Officer1@Demo2026
SEED_OFFICER_SCOREONLY_PASSWORD=Officer2@Demo2026
