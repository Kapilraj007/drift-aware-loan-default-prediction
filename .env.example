# Copy to .env for local development. Do not commit .env or reuse these values
# in a shared, staging, or production environment.

COMPOSE_PROJECT_NAME=drift-loan
APP_IMAGE=drift-loan-sprint2:local
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# Database and queue credentials. Use URL-safe values here, or URL-encode a
# production password before it is interpolated into DATABASE_URL/REDIS_URL.
POSTGRES_DB=drift_loan
POSTGRES_USER=loan_app
POSTGRES_PASSWORD=replace-with-a-long-local-password
REDIS_PASSWORD=replace-with-a-different-long-local-password
TRAINING_QUEUE=model-training
CELERY_LOG_LEVEL=INFO

# Authentication and browser access. Generate a unique random JWT secret.
JWT_SECRET_KEY=replace-with-a-long-random-local-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# Optional first-admin bootstrap. The API uses these only when the database has
# no users; remove them after the initial local setup.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Host paths mounted into the API and worker. The API mounts the model and
# feature store read-only; only the worker can write model artifacts/reports.
FEATURE_STORE_HOST_PATH=./data/processed/feature_store
MODEL_ARTIFACT_HOST_PATH=./data/artifacts/model
PREPROCESSOR_ARTIFACT_HOST_PATH=./data/artifacts/preprocessor
REPORTS_HOST_PATH=./reports/generated
